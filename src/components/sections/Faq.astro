---
import { contentId } from "../../config/content";
import Badge from "../ui/Badge.astro";
import Icon from "../ui/Icon.astro";

const { faq } = contentId;
---

<section
  id="faq"
  aria-labelledby="faq-heading"
  class="scroll-mt-16 border-b border-stone bg-ivory-light py-16 sm:py-20 lg:py-24"
>
  <div class="mx-auto max-w-[1320px] px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <!-- Left Column: Section Heading -->
      <div class="lg:col-span-4">
        <Badge tone="default">{faq.eyebrow}</Badge>
        <h2
          id="faq-heading"
          class="mt-4 font-serif text-3xl font-normal text-charcoal sm:text-4xl lg:leading-[1.12]"
        >
          {faq.headline}
        </h2>
        <p class="mt-3.5 text-sm leading-relaxed text-muted-text">
          {faq.subheadline}
        </p>
      </div>

      <!-- Right Column: Accessible Accordion -->
      <div class="lg:col-span-8">
        <div class="divide-y divide-stone border-t border-b border-stone">
          {
            faq.items.map((item, idx) => (
              <details class="group py-5" open={idx === 0}>
                <summary class="flex cursor-pointer items-center justify-between gap-4 text-left font-sans text-sm font-bold text-charcoal transition-colors hover:text-copper sm:text-base">
                  <span>{item.question}</span>
                  <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-sm border border-stone bg-ivory text-charcoal transition-transform duration-200 group-open:rotate-180">
                    <Icon name="chevron-down" size={15} />
                  </span>
                </summary>
                <div class="pt-3 pr-8 text-xs leading-relaxed text-muted-text sm:text-sm">
                  <p class="m-0">{item.answer}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
