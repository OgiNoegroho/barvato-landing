---
import { contentId } from "../../config/content";
import Badge from "../ui/Badge.astro";
import Icon from "../ui/Icon.astro";

const { bookingSimulator } = contentId;
const defaultService = bookingSimulator.services[0];
const defaultBarber = bookingSimulator.barbers[0];
const defaultDate = bookingSimulator.dates[0];
const defaultSlot = bookingSimulator.timeSlots.find((s) => s.available) ?? bookingSimulator.timeSlots[0];
---

<section
  id="simulasi-penjadwalan"
  aria-labelledby="booking-sim-heading"
  class="scroll-mt-16 border-b border-stone bg-ivory py-16 sm:py-20 lg:py-24"
>
  <div class="mx-auto max-w-[1320px] px-4 sm:px-6 lg:px-8">
    <!-- Section Heading -->
    <div class="mx-auto max-w-2xl text-center">
      <Badge tone="copper">{bookingSimulator.eyebrow}</Badge>
      <h2
        id="booking-sim-heading"
        class="mt-4 font-serif text-3xl font-normal text-charcoal sm:text-4xl lg:text-[42px] lg:leading-[1.12]"
      >
        {bookingSimulator.headline}
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-muted-text sm:text-base">
        {bookingSimulator.subheadline}
      </p>
    </div>

    <!-- Mandatory Simulation Disclaimer Banner -->
    <div
      role="note"
      aria-label="Pemberitahuan simulasi produk"
      class="mx-auto mt-8 max-w-4xl rounded-sm border border-copper/40 bg-ivory-light px-4 py-3.5 shadow-subtle sm:px-6"
    >
      <div class="flex flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-2.5">
          <span class="inline-block h-2 w-2 shrink-0 rounded-full bg-copper" aria-hidden="true" />
          <strong class="text-xs font-bold tracking-wide text-charcoal">
            {bookingSimulator.demoNoticeEn}
          </strong>
        </div>
        <span class="text-xs font-medium text-copper">
          {bookingSimulator.demoNoticeId}
        </span>
      </div>
      <p class="mt-1.5 mb-0 text-[11px] leading-relaxed text-muted-text">
        {bookingSimulator.illustrativeDisclaimer}
      </p>
    </div>

    <!-- Simulator Container -->
    <div class="mx-auto mt-8 max-w-5xl rounded-sm border border-stone bg-ivory-light shadow-card">
      <!-- Top Window Header & Stepper -->
      <div class="border-b border-stone bg-ivory-warm/60 px-4 py-4 sm:px-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <Icon name="calendar" size={16} class="text-copper" />
            <span class="text-xs font-bold tracking-wider text-charcoal uppercase">
              Simulasi Catat Booking (Contoh Interaktif)
            </span>
          </div>
          <button
            type="button"
            id="sim-reset-top"
            class="rounded-sm border border-stone bg-ivory px-3 py-1.5 text-xs font-semibold text-charcoal transition-colors hover:border-copper hover:text-copper cursor-pointer"
          >
            Ulangi Simulasi
          </button>
        </div>

        <!-- 5-Step Progress Bar -->
        <ol
          aria-label="Langkah simulasi penjadwalan"
          class="mt-4 grid grid-cols-2 gap-2 p-0 m-0 list-none sm:grid-cols-5"
        >
          {
            bookingSimulator.steps.map((step, idx) => (
              <li>
                <button
                  type="button"
                  data-sim-step-nav={step.number}
                  aria-current={idx === 0 ? "step" : undefined}
                  class={`flex w-full items-center gap-2 rounded-sm border px-3 py-2 text-left text-xs font-semibold transition-colors cursor-pointer ${
                    idx === 0
                      ? "border-charcoal bg-charcoal text-ivory-light"
                      : "border-stone bg-ivory text-charcoal hover:border-copper"
                  }`}
                >
                  <span
                    data-sim-step-badge={step.number}
                    class={`flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[10px] font-bold ${
                      idx === 0
                        ? "bg-copper text-ivory-light"
                        : "bg-ivory-warm text-charcoal"
                    }`}
                  >
                    {step.number}
                  </span>
                  <span class="truncate">{step.label}</span>
                </button>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- Main Body: Active Step + Live Selection Sidebar -->
      <div class="grid grid-cols-1 lg:grid-cols-12">
        <!-- Left Column: Steps 1 to 5 -->
        <div class="p-5 sm:p-6 lg:col-span-8 lg:border-r lg:border-stone">
          <!-- STEP 1: SELECT SERVICE -->
          <div data-sim-step-panel="1" class="block">
            <div class="mb-4">
              <span class="text-[10px] font-bold tracking-widest text-copper uppercase">
                LANGKAH 1 DARI 5 — CONTOH SIMULASI
              </span>
              <h3 class="mt-1 mb-1 font-serif text-2xl font-normal text-charcoal">
                Pilih Layanan Barbershop
              </h3>
              <p class="m-0 text-xs text-muted-text">
                Pilih salah satu contoh paket cukur beserta durasi dan harganya dalam Rupiah.
              </p>
            </div>

            <div
              role="radiogroup"
              aria-label="Contoh layanan barbershop"
              class="grid grid-cols-1 gap-3 sm:grid-cols-2"
            >
              {
                bookingSimulator.services.map((svc, idx) => (
                  <button
                    type="button"
                    role="radio"
                    aria-checked={idx === 0 ? "true" : "false"}
                    data-sim-service={svc.id}
                    data-service-name={svc.name}
                    data-service-duration={svc.durationMinutes}
                    data-service-price={svc.priceFormatted}
                    class={`flex flex-col justify-between rounded-sm border p-4 text-left transition-colors cursor-pointer ${
                      idx === 0
                        ? "border-copper bg-ivory ring-1 ring-copper"
                        : "border-stone bg-ivory hover:border-copper"
                    }`}
                  >
                    <div>
                      <div class="flex items-start justify-between gap-2">
                        <strong class="text-sm font-bold text-charcoal">
                          {svc.name}
                        </strong>
                        <span class="shrink-0 rounded-sm bg-copper/12 px-2 py-0.5 text-xs font-bold text-copper">
                          {svc.priceFormatted}
                        </span>
                      </div>
                      <p class="mt-1.5 mb-0 text-xs leading-relaxed text-muted-text">
                        {svc.description}
                      </p>
                    </div>
                    <div class="mt-3 flex items-center justify-between border-t border-stone/70 pt-2.5 text-[11px] font-medium text-muted-text">
                      <span class="flex items-center gap-1">
                        <Icon name="clock" size={12} class="text-copper" />
                        Durasi: {svc.durationMinutes} menit
                      </span>
                      <span class="text-copper font-semibold">Contoh Layanan</span>
                    </div>
                  </button>
                ))
              }
            </div>
          </div>

          <!-- STEP 2: SELECT BARBER -->
          <div data-sim-step-panel="2" class="hidden">
            <div class="mb-4">
              <span class="text-[10px] font-bold tracking-widest text-copper uppercase">
                LANGKAH 2 DARI 5 — CONTOH SIMULASI
              </span>
              <h3 class="mt-1 mb-1 font-serif text-2xl font-normal text-charcoal">
                Pilih Kapster yang Bertugas
              </h3>
              <p class="m-0 text-xs text-muted-text">
                Pilih kapster yang bakal melayani pelanggan sesuai contoh ketersediaan kursi.
              </p>
            </div>

            <div
              role="radiogroup"
              aria-label="Contoh kapster barbershop"
              class="grid grid-cols-1 gap-3 sm:grid-cols-2"
            >
              {
                bookingSimulator.barbers.map((brb, idx) => (
                  <button
                    type="button"
                    role="radio"
                    aria-checked={idx === 0 ? "true" : "false"}
                    data-sim-barber={brb.id}
                    data-barber-name={brb.name}
                    data-barber-role={brb.role}
                    data-barber-specialty={brb.specialty}
                    class={`flex flex-col justify-between rounded-sm border p-4 text-left transition-colors cursor-pointer ${
                      idx === 0
                        ? "border-copper bg-ivory ring-1 ring-copper"
                        : "border-stone bg-ivory hover:border-copper"
                    }`}
                  >
                    <div>
                      <div class="flex items-center justify-between gap-2">
                        <strong class="text-sm font-bold text-charcoal">
                          {brb.name}
                        </strong>
                        <Icon name="scissors" size={14} class="text-copper" />
                      </div>
                      <span class="mt-0.5 block text-xs font-medium text-muted-text">
                        {brb.role}
                      </span>
                      <p class="mt-2 mb-0 text-xs text-charcoal">
                        Keahlian: <span class="font-medium">{brb.specialty}</span>
                      </p>
                    </div>
                    <div class="mt-3 border-t border-stone/70 pt-2.5">
                      <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-sage">
                        <span class="h-1.5 w-1.5 rounded-full bg-sage" aria-hidden="true" />
                        {brb.availabilityTag}
                      </span>
                    </div>
                  </button>
                ))
              }
            </div>
          </div>

          <!-- STEP 3: SELECT DATE -->
          <div data-sim-step-panel="3" class="hidden">
            <div class="mb-4">
              <span class="text-[10px] font-bold tracking-widest text-copper uppercase">
                LANGKAH 3 DARI 5 — CONTOH SIMULASI
              </span>
              <h3 class="mt-1 mb-1 font-serif text-2xl font-normal text-charcoal">
                Pilih Hari Kedatangan
              </h3>
              <p class="m-0 text-xs text-muted-text">
                Pilih contoh hari kedatangan pelanggan buat melihat slot jam yang masih kosong.
              </p>
            </div>

            <div
              role="radiogroup"
              aria-label="Contoh tanggal kedatangan"
              class="grid grid-cols-1 gap-3 sm:grid-cols-2"
            >
              {
                bookingSimulator.dates.map((dt, idx) => (
                  <button
                    type="button"
                    role="radio"
                    aria-checked={idx === 0 ? "true" : "false"}
                    data-sim-date={dt.id}
                    data-date-offset={idx}
                    data-date-label={dt.label}
                    class={`flex items-center justify-between rounded-sm border p-4 text-left transition-colors cursor-pointer ${
                      idx === 0
                        ? "border-copper bg-ivory ring-1 ring-copper"
                        : "border-stone bg-ivory hover:border-copper"
                    }`}
                  >
                    <div>
                      <strong class="block text-sm font-bold text-charcoal" data-date-title={dt.id}>
                        {dt.label}
                      </strong>
                      <span class="mt-1 block text-xs text-muted-text" data-date-subtitle={dt.id}>
                        {dt.sublabel}
                      </span>
                    </div>
                    <Icon name="calendar" size={18} class="text-copper" />
                  </button>
                ))
              }
            </div>
          </div>

          <!-- STEP 4: SELECT TIME SLOT -->
          <div data-sim-step-panel="4" class="hidden">
            <div class="mb-4">
              <span class="text-[10px] font-bold tracking-widest text-copper uppercase">
                LANGKAH 4 DARI 5 — CONTOH SIMULASI
              </span>
              <h3 class="mt-1 mb-1 font-serif text-2xl font-normal text-charcoal">
                Pilih Jam Booking
              </h3>
              <p class="m-0 text-xs text-muted-text">
                Pilih salah satu jam yang kosong. Slot bertanda &ldquo;Contoh Terisi&rdquo; menunjukkan cara Barvato mencegah jadwal bentrok di kalender.
              </p>
            </div>

            <div
              role="radiogroup"
              aria-label="Contoh jam layanan"
              class="grid grid-cols-2 gap-3 sm:grid-cols-4"
            >
              {
                bookingSimulator.timeSlots.map((slot) => {
                  const isDefault = slot.id === defaultSlot.id;
                  return (
                    <button
                      type="button"
                      role="radio"
                      disabled={!slot.available}
                      aria-checked={isDefault ? "true" : "false"}
                      data-sim-slot={slot.id}
                      data-slot-time={slot.time}
                      data-slot-period={slot.period}
                      class={`flex flex-col items-center justify-center rounded-sm border p-3.5 text-center transition-colors ${
                        !slot.available
                          ? "cursor-not-allowed border-stone/60 bg-ivory-warm/50 text-stone-muted opacity-65"
                          : isDefault
                            ? "cursor-pointer border-copper bg-ivory ring-1 ring-copper text-charcoal"
                            : "cursor-pointer border-stone bg-ivory text-charcoal hover:border-copper"
                      }`}
                    >
                      <strong class="text-sm font-bold">{slot.time} WIB</strong>
                      <span class="mt-1 text-[11px] font-medium text-muted-text">
                        {slot.available ? `Sesi ${slot.period}` : "Contoh Terisi"}
                      </span>
                    </button>
                  );
                })
              }
            </div>
          </div>

          <!-- STEP 5: BOOKING SUMMARY -->
          <div data-sim-step-panel="5" class="hidden">
            <div class="mb-4">
              <span class="text-[10px] font-bold tracking-widest text-copper uppercase">
                LANGKAH 5 DARI 5 — RINGKASAN SIMULASI
              </span>
              <h3 class="mt-1 mb-1 font-serif text-2xl font-normal text-charcoal">
                Ringkasan Booking Simulasi
              </h3>
              <p class="m-0 text-xs text-muted-text">
                Ini tampilan ringkasan jadwal dari pilihan kamu di atas. Karena cuma simulasi di halaman web, nggak ada data yang dikirim atau disimpan ke server.
              </p>
            </div>

            <div class="rounded-sm border border-stone bg-ivory p-5">
              <div class="flex flex-wrap items-center justify-between gap-2 border-b border-stone pb-3.5">
                <div>
                  <span class="text-[10px] font-bold tracking-widest text-copper uppercase">
                    CONTOH KARTU BOOKING
                  </span>
                  <h4 class="mt-0.5 mb-0 text-base font-bold text-charcoal" id="summary-card-service">
                    {defaultService.name}
                  </h4>
                </div>
                <Badge tone="copper">Simulasi Selesai</Badge>
              </div>

              <dl class="mt-4 grid grid-cols-1 gap-3.5 m-0 sm:grid-cols-2">
                <div class="rounded-sm border border-stone/80 bg-ivory-light p-3">
                  <dt class="text-[11px] font-semibold text-muted-text uppercase">
                    Layanan &amp; Durasi (Contoh)
                  </dt>
                  <dd class="mt-1 m-0 text-sm font-bold text-charcoal">
                    <span id="summary-detail-service">{defaultService.name}</span>
                    <span class="block text-xs font-normal text-muted-text" id="summary-detail-duration">
                      Estimasi {defaultService.durationMinutes} menit
                    </span>
                  </dd>
                </div>

                <div class="rounded-sm border border-stone/80 bg-ivory-light p-3">
                  <dt class="text-[11px] font-semibold text-muted-text uppercase">
                    Kapster Bertugas (Contoh)
                  </dt>
                  <dd class="mt-1 m-0 text-sm font-bold text-charcoal">
                    <span id="summary-detail-barber">{defaultBarber.name}</span>
                    <span class="block text-xs font-normal text-muted-text" id="summary-detail-barber-role">
                      {defaultBarber.role}
                    </span>
                  </dd>
                </div>

                <div class="rounded-sm border border-stone/80 bg-ivory-light p-3">
                  <dt class="text-[11px] font-semibold text-muted-text uppercase">
                    Hari &amp; Jam Booking (Contoh)
                  </dt>
                  <dd class="mt-1 m-0 text-sm font-bold text-charcoal">
                    <span id="summary-detail-date">{defaultDate.label}</span>
                    <span class="block text-xs font-normal text-muted-text" id="summary-detail-time">
                      Pukul {defaultSlot.time} WIB (Sesi {defaultSlot.period})
                    </span>
                  </dd>
                </div>

                <div class="rounded-sm border border-stone/80 bg-ivory-light p-3">
                  <dt class="text-[11px] font-semibold text-muted-text uppercase">
                    Harga Layanan (Contoh)
                  </dt>
                  <dd class="mt-1 m-0 text-base font-bold text-copper" id="summary-detail-price">
                    {defaultService.priceFormatted}
                  </dd>
                  <span class="block text-[11px] text-muted-text">
                    Contoh harga layanan dalam Rupiah
                  </span>
                </div>
              </dl>

              <p class="mt-4 mb-0 rounded-sm border border-stone bg-ivory-warm/50 px-3.5 py-2.5 text-xs leading-relaxed text-muted-text">
                <strong>Catatan Simulasi:</strong> {bookingSimulator.demoNoticeEn}
              </p>
            </div>
          </div>

          <!-- Step Footer Navigation Controls -->
          <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-stone pt-4">
            <button
              type="button"
              id="sim-btn-prev"
              disabled
              class="rounded-sm border border-stone bg-ivory px-4 py-2 text-xs font-semibold text-charcoal transition-colors hover:border-copper disabled:cursor-not-allowed disabled:opacity-45 cursor-pointer"
            >
              &larr; Kembali
            </button>

            <div class="flex items-center gap-2.5">
              <button
                type="button"
                id="sim-btn-reset"
                class="hidden rounded-sm border border-stone bg-ivory px-4 py-2 text-xs font-semibold text-charcoal transition-colors hover:border-copper cursor-pointer"
              >
                Coba Lagi dari Awal
              </button>
              <button
                type="button"
                id="sim-btn-next"
                class="inline-flex items-center gap-1.5 rounded-sm bg-copper px-4 py-2 text-xs font-semibold text-ivory-light transition-colors hover:bg-copper-hover cursor-pointer"
              >
                <span id="sim-btn-next-label">Lanjut: Pilih Kapster</span>
                <Icon name="arrow-right" size={14} />
              </button>
            </div>
          </div>
        </div>

        <!-- Right Column: Live Selection Sidebar -->
        <aside
          aria-label="Ringkasan pilihan simulasi kamu saat ini"
          class="bg-ivory p-5 sm:p-6 lg:col-span-4"
        >
          <span class="text-[10px] font-bold tracking-widest text-copper uppercase">
            PILIHAN KAMU SAAT INI
          </span>
          <h4 class="mt-1 mb-4 font-serif text-xl font-normal text-charcoal">
            Ringkasan Booking
          </h4>

          <dl class="space-y-3 m-0 text-xs">
            <div class="flex items-start justify-between gap-2 border-b border-stone/70 pb-2.5">
              <dt class="text-muted-text">1. Layanan:</dt>
              <dd class="m-0 text-right font-semibold text-charcoal" id="live-sim-service">
                {defaultService.name}
              </dd>
            </div>
            <div class="flex items-start justify-between gap-2 border-b border-stone/70 pb-2.5">
              <dt class="text-muted-text">Durasi:</dt>
              <dd class="m-0 text-right font-medium text-charcoal" id="live-sim-duration">
                {defaultService.durationMinutes} menit
              </dd>
            </div>
            <div class="flex items-start justify-between gap-2 border-b border-stone/70 pb-2.5">
              <dt class="text-muted-text">2. Kapster:</dt>
              <dd class="m-0 text-right font-semibold text-charcoal" id="live-sim-barber">
                {defaultBarber.name}
              </dd>
            </div>
            <div class="flex items-start justify-between gap-2 border-b border-stone/70 pb-2.5">
              <dt class="text-muted-text">3. Hari:</dt>
              <dd class="m-0 text-right font-semibold text-charcoal" id="live-sim-date">
                {defaultDate.label}
              </dd>
            </div>
            <div class="flex items-start justify-between gap-2 border-b border-stone/70 pb-2.5">
              <dt class="text-muted-text">4. Jam:</dt>
              <dd class="m-0 text-right font-semibold text-charcoal" id="live-sim-time">
                {defaultSlot.time} WIB
              </dd>
            </div>
            <div class="flex items-center justify-between gap-2 pt-1">
              <dt class="font-bold text-charcoal">Harga Contoh:</dt>
              <dd class="m-0 text-sm font-bold text-copper" id="live-sim-price">
                {defaultService.priceFormatted}
              </dd>
            </div>
          </dl>

          <div class="mt-5 rounded-sm border border-stone bg-ivory-light p-3 text-[11px] leading-relaxed text-muted-text">
            Semua pilihan di atas cuma contoh buat memperlihatkan gimana info layanan, kapster, dan jam booking dirangkum rapi di Barvato.
          </div>
        </aside>
      </div>
    </div>
  </div>
</section>

<script>
  const stepPanels = Array.from(
    document.querySelectorAll<HTMLElement>("[data-sim-step-panel]")
  );
  const stepNavButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-sim-step-nav]")
  );
  const serviceButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-sim-service]")
  );
  const barberButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-sim-barber]")
  );
  const dateButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-sim-date]")
  );
  const slotButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-sim-slot]:not([disabled])")
  );

  const prevBtn = document.getElementById("sim-btn-prev") as HTMLButtonElement | null;
  const nextBtn = document.getElementById("sim-btn-next") as HTMLButtonElement | null;
  const nextBtnLabel = document.getElementById("sim-btn-next-label");
  const resetBtn = document.getElementById("sim-btn-reset") as HTMLButtonElement | null;
  const resetTopBtn = document.getElementById("sim-reset-top") as HTMLButtonElement | null;

  const nextLabels: Record<number, string> = {
    1: "Lanjut: Pilih Kapster",
    2: "Lanjut: Pilih Hari",
    3: "Lanjut: Pilih Jam",
    4: "Lihat Ringkasan Booking",
  };

  let currentStep = 1;

  const state = {
    serviceName: "Potong Rambut Reguler",
    serviceDuration: "30",
    servicePrice: "Rp 35.000",
    barberName: "Rizky Pratama",
    barberRole: "Senior Kapster (Contoh)",
    dateLabel: "Hari Ini",
    slotTime: "09:30",
    slotPeriod: "Pagi",
  };

  function setText(id: string, value: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  }

  function updateSummaryDom() {
    setText("live-sim-service", state.serviceName);
    setText("live-sim-duration", `${state.serviceDuration} menit`);
    setText("live-sim-barber", state.barberName);
    setText("live-sim-date", state.dateLabel);
    setText("live-sim-time", `${state.slotTime} WIB`);
    setText("live-sim-price", state.servicePrice);

    setText("summary-card-service", state.serviceName);
    setText("summary-detail-service", state.serviceName);
    setText("summary-detail-duration", `Estimasi ${state.serviceDuration} menit`);
    setText("summary-detail-barber", state.barberName);
    setText("summary-detail-barber-role", state.barberRole);
    setText("summary-detail-date", state.dateLabel);
    setText("summary-detail-time", `Pukul ${state.slotTime} WIB (Sesi ${state.slotPeriod})`);
    setText("summary-detail-price", state.servicePrice);
  }

  function goToStep(step: number) {
    currentStep = Math.max(1, Math.min(5, step));

    stepPanels.forEach((panel) => {
      const panelStep = Number(panel.dataset.simStepPanel);
      panel.classList.toggle("hidden", panelStep !== currentStep);
      panel.classList.toggle("block", panelStep === currentStep);
    });

    stepNavButtons.forEach((btn) => {
      const btnStep = Number(btn.dataset.simStepNav);
      const badge = btn.querySelector<HTMLElement>(`[data-sim-step-badge="${btnStep}"]`);
      if (btnStep === currentStep) {
        btn.setAttribute("aria-current", "step");
        btn.classList.remove("border-stone", "bg-ivory", "text-charcoal");
        btn.classList.add("border-charcoal", "bg-charcoal", "text-ivory-light");
        if (badge) {
          badge.classList.remove("bg-ivory-warm", "text-charcoal");
          badge.classList.add("bg-copper", "text-ivory-light");
        }
      } else {
        btn.removeAttribute("aria-current");
        btn.classList.remove("border-charcoal", "bg-charcoal", "text-ivory-light");
        btn.classList.add("border-stone", "bg-ivory", "text-charcoal");
        if (badge) {
          badge.classList.remove("bg-copper", "text-ivory-light");
          badge.classList.add("bg-ivory-warm", "text-charcoal");
        }
      }
    });

    if (prevBtn) {
      prevBtn.disabled = currentStep === 1;
    }

    if (nextBtn && resetBtn) {
      if (currentStep === 5) {
        nextBtn.classList.add("hidden");
        resetBtn.classList.remove("hidden");
      } else {
        nextBtn.classList.remove("hidden");
        resetBtn.classList.add("hidden");
        if (nextBtnLabel) {
          nextBtnLabel.textContent = nextLabels[currentStep] ?? "Lanjut";
        }
      }
    }
  }

  function highlightRadioGroup(
    buttons: HTMLButtonElement[],
    activeBtn: HTMLButtonElement
  ) {
    buttons.forEach((btn) => {
      const isSelected = btn === activeBtn;
      btn.setAttribute("aria-checked", String(isSelected));
      if (isSelected) {
        btn.classList.remove("border-stone");
        btn.classList.add("border-copper", "ring-1", "ring-copper");
      } else {
        btn.classList.remove("border-copper", "ring-1", "ring-copper");
        btn.classList.add("border-stone");
      }
    });
  }

  serviceButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      highlightRadioGroup(serviceButtons, btn);
      state.serviceName = btn.dataset.serviceName ?? state.serviceName;
      state.serviceDuration = btn.dataset.serviceDuration ?? state.serviceDuration;
      state.servicePrice = btn.dataset.servicePrice ?? state.servicePrice;
      updateSummaryDom();
    });
  });

  barberButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      highlightRadioGroup(barberButtons, btn);
      state.barberName = btn.dataset.barberName ?? state.barberName;
      state.barberRole = btn.dataset.barberRole ?? state.barberRole;
      updateSummaryDom();
    });
  });

  dateButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      highlightRadioGroup(dateButtons, btn);
      state.dateLabel = btn.dataset.dateLabel ?? state.dateLabel;
      updateSummaryDom();
    });
  });

  slotButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      highlightRadioGroup(slotButtons, btn);
      state.slotTime = btn.dataset.slotTime ?? state.slotTime;
      state.slotPeriod = btn.dataset.slotPeriod ?? state.slotPeriod;
      updateSummaryDom();
    });
  });

  stepNavButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetStep = Number(btn.dataset.simStepNav);
      if (targetStep) goToStep(targetStep);
    });
  });

  prevBtn?.addEventListener("click", () => {
    if (currentStep > 1) goToStep(currentStep - 1);
  });

  nextBtn?.addEventListener("click", () => {
    if (currentStep < 5) goToStep(currentStep + 1);
  });

  function resetSimulation() {
    if (serviceButtons[0]) serviceButtons[0].click();
    if (barberButtons[0]) barberButtons[0].click();
    if (dateButtons[0]) dateButtons[0].click();
    if (slotButtons[0]) slotButtons[0].click();
    goToStep(1);
  }

  resetBtn?.addEventListener("click", resetSimulation);
  resetTopBtn?.addEventListener("click", resetSimulation);
</script>
