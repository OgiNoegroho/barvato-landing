---
import { contentId } from "../../config/content";
import Badge from "../ui/Badge.astro";
import Icon from "../ui/Icon.astro";
import BrowserFrame from "../ui/BrowserFrame.astro";

const { featuresSection } = contentId;
---

<section
  id="fitur"
  aria-labelledby="features-heading"
  class="scroll-mt-16 border-b border-stone bg-ivory py-16 sm:py-20 lg:py-24"
>
  <div class="mx-auto max-w-[1320px] px-4 sm:px-6 lg:px-8">
    <!-- Section Heading -->
    <div class="mx-auto max-w-2xl text-center">
      <Badge tone="copper">{featuresSection.eyebrow}</Badge>
      <h2
        id="features-heading"
        class="mt-4 font-serif text-3xl font-normal text-charcoal sm:text-4xl lg:text-[44px] lg:leading-[1.1]"
      >
        {featuresSection.headline}
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-muted-text sm:text-base">
        {featuresSection.subheadline}
      </p>
    </div>

    <!-- Editorial Feature Blocks -->
    <div class="mt-14 divide-y divide-stone sm:mt-16">
      {
        featuresSection.items.map((feature, index) => {
          const isReversed = index % 2 === 1;
          return (
            <article
              id={feature.id}
              class="grid grid-cols-1 gap-8 py-12 first:pt-0 last:pb-0 lg:grid-cols-12 lg:items-center lg:gap-12 lg:py-16"
            >
              <!-- Copy Column -->
              <div
                class={`lg:col-span-5 ${isReversed ? "lg:order-2" : "lg:order-1"}`}
              >
                <div class="flex items-center gap-3">
                  <span class="font-serif text-lg font-bold text-copper">
                    {feature.number}
                  </span>
                  <span class="h-px w-6 bg-stone-muted" aria-hidden="true" />
                  <span class="text-[11px] font-bold tracking-widest text-muted-text uppercase">
                    {feature.eyebrow}
                  </span>
                </div>

                <h3 class="mt-3 font-serif text-2xl font-normal text-charcoal sm:text-3xl lg:leading-tight">
                  {feature.title}
                </h3>

                <p class="mt-3.5 text-sm leading-relaxed text-muted-text">
                  {feature.description}
                </p>

                <ul class="mt-6 flex flex-col gap-3 list-none p-0 m-0">
                  {feature.bullets.map((bullet) => (
                    <li class="flex items-start gap-3 text-xs leading-relaxed text-charcoal sm:text-sm">
                      <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-copper-soft/80 text-copper">
                        <Icon name="check" size={12} />
                      </span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Screenshot Column -->
              <div
                class={`lg:col-span-7 ${isReversed ? "lg:order-1" : "lg:order-2"}`}
              >
                <BrowserFrame
                  src={feature.image.src}
                  alt={feature.image.alt}
                  width={feature.image.width}
                  height={feature.image.height}
                  caption={feature.image.caption}
                  title={`BARVATO — ${feature.eyebrow}`}
                />
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
