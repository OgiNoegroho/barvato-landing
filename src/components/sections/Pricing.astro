---
import { contentId } from "../../config/content";
import { siteConfig } from "../../config/site";
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";

const { pricing } = contentId;
---

<section
  id="harga"
  aria-labelledby="pricing-heading"
  class="scroll-mt-16 border-b border-stone bg-ivory py-16 sm:py-20 lg:py-24"
>
  <div class="mx-auto max-w-[1320px] px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <Badge tone="amber">{pricing.eyebrow}</Badge>
      <h2
        id="pricing-heading"
        class="mt-4 font-serif text-3xl font-normal text-charcoal sm:text-4xl lg:text-[42px] lg:leading-[1.12]"
      >
        {pricing.headline}
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-muted-text sm:text-base">
        {pricing.description}
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-3xl">
      <Card variant="elevated" class="p-6 sm:p-10">
        <div class="flex flex-col justify-between gap-6 border-b border-stone pb-8 sm:flex-row sm:items-center">
          <div>
            <Badge tone="copper">{pricing.statusBadge}</Badge>
            <h3 class="mt-3 mb-0 font-serif text-2xl font-normal text-charcoal sm:text-3xl">
              {pricing.cardTitle}
            </h3>
            <p class="mt-2 mb-0 max-w-xl text-xs leading-relaxed text-muted-text sm:text-sm">
              {pricing.cardSubtitle}
            </p>
          </div>

          <div class="shrink-0">
            <Button
              href={siteConfig.cta.contactUrl}
              variant="primary"
              size="lg"
              class="w-full sm:w-auto"
            >
              <span>{siteConfig.cta.contactLabel}</span>
              <Icon name="arrow-right" size={16} />
            </Button>
          </div>
        </div>

        <div class="mt-8">
          <h4 class="text-xs font-bold tracking-wider text-charcoal uppercase">
            {pricing.includedHeading}
          </h4>

          <ul class="mt-5 grid grid-cols-1 gap-3.5 sm:grid-cols-2 list-none p-0 m-0">
            {
              pricing.includedFeatures.map((feat) => (
                <li class="flex items-start gap-2.5 text-xs leading-relaxed text-charcoal sm:text-sm">
                  <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-forest-soft text-forest">
                    <Icon name="check" size={12} />
                  </span>
                  <span>{feat}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-8 border-t border-stone pt-5 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <p class="m-0 text-xs text-muted-text">
            {pricing.note}
          </p>
          <a
            href={siteConfig.cta.loginUrl}
            class="shrink-0 text-xs font-semibold text-copper no-underline hover:underline"
          >
            Sudah punya akun? Masuk di sini &rarr;
          </a>
        </div>
      </Card>
    </div>
  </div>
</section>
