---
import { siteConfig } from "../../config/site";
import { contentId } from "../../config/content";

const currentYear = new Date().getFullYear();
const { footer } = contentId;
---

<footer class="border-t border-charcoal-muted bg-charcoal text-ivory-light">
  <div class="mx-auto max-w-[1320px] px-4 py-14 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <!-- Brand Column -->
      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <span
            class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-copper font-serif text-xl font-bold text-ivory-light"
            aria-hidden="true"
          >
            B
          </span>
          <div class="flex flex-col">
            <span class="font-serif text-xl leading-none tracking-wide text-ivory-light">
              BARVATO
            </span>
            <span class="mt-0.5 text-[9px] font-bold tracking-widest text-stone-muted uppercase">
              Manajemen Barbershop
            </span>
          </div>
        </div>
        <p class="mt-4 max-w-sm text-xs leading-relaxed text-stone-muted">
          {footer.description}
        </p>
      </div>

      <!-- Product Navigation -->
      <div class="md:col-span-2">
        <h2 class="text-[11px] font-bold tracking-widest text-ivory-light uppercase">
          {footer.navigationHeading}
        </h2>
        <ul class="mt-4 flex flex-col gap-2.5 list-none p-0 m-0">
          {
            siteConfig.navLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-xs text-stone-muted no-underline transition-colors hover:text-ivory-light"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={siteConfig.cta.loginUrl}
              class="text-xs text-stone-muted no-underline transition-colors hover:text-ivory-light"
            >
              {siteConfig.cta.loginLabel}
            </a>
          </li>
        </ul>
      </div>

      <!-- Operational Capabilities -->
      <div class="md:col-span-3">
        <h2 class="text-[11px] font-bold tracking-widest text-ivory-light uppercase">
          {footer.capabilitiesHeading}
        </h2>
        <ul class="mt-4 flex flex-col gap-2.5 list-none p-0 m-0">
          {
            footer.capabilitiesList.map((item) => (
              <li class="text-xs text-stone-muted">
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact & Access -->
      <div class="md:col-span-2">
        <h2 class="text-[11px] font-bold tracking-widest text-ivory-light uppercase">
          {footer.contactHeading}
        </h2>
        <p class="mt-4 text-xs leading-relaxed text-stone-muted">
          {footer.contactDescription}
        </p>
        <div class="mt-4 flex flex-col gap-2">
          <a
            href={siteConfig.cta.contactUrl}
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-copper-soft no-underline transition-colors hover:text-ivory-light"
          >
            {siteConfig.cta.contactLabel} &rarr;
          </a>
          <a
            href={siteConfig.cta.loginUrl}
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-stone-muted no-underline transition-colors hover:text-ivory-light"
          >
            Masuk ke Dashboard &rarr;
          </a>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-charcoal-muted pt-8 sm:flex-row sm:items-center">
      <p class="m-0 text-xs text-stone-muted">
        &copy; {currentYear} {siteConfig.name}. {footer.rightsText}
      </p>
      <p class="m-0 text-[11px] text-stone-muted/80">
        Aplikasi Manajemen Barbershop Modern
      </p>
    </div>
  </div>
</footer>
