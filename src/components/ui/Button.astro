---
export type ButtonVariant = "primary" | "copper" | "secondary" | "outline" | "ghost";
export type ButtonSize = "sm" | "md" | "lg";

interface Props {
  href?: string;
  variant?: ButtonVariant;
  size?: ButtonSize;
  class?: string;
  id?: string;
  ariaLabel?: string;
  target?: string;
  rel?: string;
  type?: "button" | "submit" | "reset";
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  id,
  ariaLabel,
  target,
  rel,
  type = "button",
} = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center font-sans font-semibold transition-colors duration-150 select-none cursor-pointer rounded-sm";

const variantStyles: Record<ButtonVariant, string> = {
  primary:
    "bg-charcoal text-ivory-light border border-charcoal hover:bg-copper hover:border-copper active:bg-copper-hover shadow-subtle",
  copper:
    "bg-copper text-ivory-light border border-copper hover:bg-copper-hover hover:border-copper-hover active:bg-charcoal shadow-subtle",
  secondary:
    "bg-ivory-warm text-charcoal border border-stone hover:bg-stone/50 hover:border-stone-muted active:bg-stone shadow-subtle",
  outline:
    "bg-ivory-light text-charcoal border border-stone hover:border-copper hover:bg-ivory active:bg-ivory-warm shadow-subtle",
  ghost:
    "bg-transparent text-charcoal border border-transparent hover:bg-ivory-warm/70 active:bg-ivory-warm",
};

const sizeStyles: Record<ButtonSize, string> = {
  sm: "h-9 px-3.5 text-xs gap-1.5",
  md: "h-10 px-4 text-xs gap-2",
  lg: "h-12 px-6 text-sm gap-2.5",
};

const classes = `${baseStyles} ${variantStyles[variant]} ${sizeStyles[size]} ${className}`.trim();
---

{
  href ? (
    <a href={href} id={id} aria-label={ariaLabel} target={target} rel={rel} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} id={id} aria-label={ariaLabel} class={classes}>
      <slot />
    </button>
  )
}
