# Canonical base URL for SEO, OpenGraph, robots.txt, and sitemap.xml
PUBLIC_SITE_URL=http://localhost:4321

# Operational web application login URL
PUBLIC_APP_LOGIN_URL=http://localhost:3000

# Destination for "Mulai Gratis" trial CTA (defaults to #hubungi-kami until backend registration endpoint is exposed)
PUBLIC_TRIAL_CTA_URL=#hubungi-kami

# Destination for "Hubungi Kami" contact CTA (e.g., mailto: or verified WhatsApp URL when available)
PUBLIC_CONTACT_URL=mailto:halo@barvato.id?subject=Informasi%20Produk%20Barvato
